# Copy to .env (gitignored). Paths only; never put key contents here.
# A file that sets ASC_KEY_ID, ASC_ISSUER_ID and ASC_KEY_PATH (App Manager or Admin key).
ASC_ENV_FILE=
# Google Play service account JSON key.
PLAY_KEY_FILE=
# RevenueCat: Project settings › API keys › New secret API key (v2), Read & Write on Project configuration.
REVENUECAT_API_KEY=
# The id in the dashboard URL: app.revenuecat.com/projects/<id>/...
REVENUECAT_PROJECT_ID=
