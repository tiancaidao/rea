# generated model artifacts (train your own; don't commit)
*.onnx
*.npz
*.tflite
*.mlmodel
# python
__pycache__/
*.pyc
# mock backend state
mock-api/mock-db.json
# flutter
flutter_app/.dart_tool/
flutter_app/build/
flutter_app/.flutter-plugins*

# APK-extracted assets used ONLY as local comparison placeholders.
# These are Northcube's copyrighted material — kept local, never redistributed.
# Run tools/extract_placeholders.sh against the APK to repopulate for a demo.
flutter_app/assets/audio/*
!flutter_app/assets/audio/.gitkeep
flutter_app/assets/video/*
!flutter_app/assets/video/.gitkeep
flutter_app/assets/images/*
!flutter_app/assets/images/.gitkeep
flutter_app/assets/fonts/*
!flutter_app/assets/fonts/.gitkeep
flutter_app/assets/lottie/*
!flutter_app/assets/lottie/.gitkeep
flutter_app/assets/icon/*
!flutter_app/assets/icon/.gitkeep
# trained models are produced by ml/training/train_snore.py, never committed
flutter_app/assets/models/*
!flutter_app/assets/models/.gitkeep
flutter_app/assets/data/*.csv
flutter_app/assets/data/sleep_aid_index.json
flutter_app/assets/data/strings.en.json

# project config for --dart-define-from-file (keep out of the public repo)
flutter_app/config/*.json
!flutter_app/config/backend.example.json
