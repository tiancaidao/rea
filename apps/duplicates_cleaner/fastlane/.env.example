# Copy to fastlane/.env (gitignored) and fill in. fastlane loads it automatically.
# The same App Store Connect API key works for every app on the team.

# App Store Connect API key (App Store Connect > Users and Access > Integrations).
ASC_KEY_ID=
ASC_ISSUER_ID=
# Path to the AuthKey_<KEY_ID>.p8 file, kept outside the repo.
ASC_KEY_PATH=
# Or, on CI, the .p8 contents base64-encoded instead of a path:
# ASC_KEY_CONTENT_BASE64=

# Optional overrides.
# APP_IDENTIFIER=com.duplicates-cleaner.ios
# APPLE_TEAM_ID=PYN33LW94S
# BUILD_NUMBER=42          # default: max(pubspec build number, latest TestFlight build + 1)
# CHANGELOG="What to test"

# Optional: sign with fastlane match instead of Xcode automatic signing.
# MATCH_GIT_URL=git@github.com:tiancaidao/ios-certificates.git
# MATCH_PASSWORD=
